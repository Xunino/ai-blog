---
import TreeNav from './TreeNav.astro';
import type { TreeItem } from '../lib/tree';
import type { Locale } from '../../site.config';
import { useTranslations } from '../i18n/ui';

interface Props {
  tree: TreeItem[];
  currentUrl: string;
  locale: Locale;
}

const { tree, currentUrl, locale } = Astro.props;
const t = useTranslations(locale);
const title = locale === 'vi' ? 'Nội dung sách' : 'Contents';
---

<aside class="sidebar-tree-rail" aria-label="Knowledge base navigation" transition:name="sidebar-tree">
  <div class="sidebar-tree-header">
    <span class="sidebar-title">{title}</span>
    <button
      id="mobile-sidebar-close"
      class="icon-btn mobile-sidebar-close"
      type="button"
      title={t('nav.close')}
      aria-label={t('nav.close')}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="sidebar-mobile-nav">
    <a href={`/${locale}/`} class="sidebar-nav-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <span>{t('nav.home')}</span>
    </a>
    <a href={`/${locale}/tags/`} class="sidebar-nav-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
        <line x1="7" y1="7" x2="7.01" y2="7"></line>
      </svg>
      <span>{t('nav.tags')}</span>
    </a>
  </div>

  <nav class="sidebar-tree-content">
    <TreeNav items={tree} currentUrl={currentUrl} />
  </nav>
</aside>

<style>
  .sidebar-tree-rail {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .sidebar-tree-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.5rem 0.7rem;
    margin-bottom: 0.15rem;
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 650;
    line-height: 1.4;
  }

  .mobile-sidebar-close {
    display: none;
    width: 32px;
    height: 32px;
    padding: 0;
  }

  .sidebar-mobile-nav {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0 0.5rem 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .sidebar-nav-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.88rem;
    font-weight: 550;
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .sidebar-nav-link svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .sidebar-nav-link:hover,
  .sidebar-nav-link:active {
    color: var(--text);
    background: var(--bg-subtle);
  }

  .sidebar-tree-content {
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border-hover) transparent;
    padding-inline-end: 0.2rem;
    padding-bottom: var(--space-xl);
    flex: 1;
    -webkit-overflow-scrolling: touch;
  }

  @media (max-width: 1023px) {
    .sidebar-tree-header {
      padding: 1rem 1.25rem 0.75rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 0.5rem;
    }

    .sidebar-title {
      font-size: 0.95rem;
      font-weight: 700;
    }

    .mobile-sidebar-close {
      display: inline-flex;
    }

    .sidebar-mobile-nav {
      display: flex;
      padding: 0.25rem 0.75rem 0.75rem;
    }

    .sidebar-tree-content {
      padding-inline: 0.75rem;
    }
  }
</style>
